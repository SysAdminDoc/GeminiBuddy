{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "54.0.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://api.github.com/*",
    "https://gist.githubusercontent.com/*",
    "https://raw.githubusercontent.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "gm-shim.js",
        "network-policy.js",
        "i18n.js",
        "GeminiBuddy.user.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "__MSG_actionOpenSidePanel__"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "geminibuddy@sysadmindoc.github.io"
    }
  }
}
